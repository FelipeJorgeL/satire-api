meta {
  name: Reject invalid login
  type: http
  seq: 4
  tags: [
    customer
    negative
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "definitely-the-wrong-password"
  }
}

tests {
  test("returns 401 Unauthorized", function () {
    expect(res.status).to.equal(401);
  });

  test("does not reveal which field was wrong", function () {
    expect(JSON.stringify(res.body)).not.to.match(/password|email/i);
  });
}

docs {
  Wrong password, unknown email and inactive account must all produce this same
  generic 401 — never a hint about which one it was (prevents user enumeration).
}
