meta {
  name: Register customer
  type: http
  seq: 1
  tags: [
    customer
    smoke
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{CUSTOMER_NAME}}",
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "{{CUSTOMER_PASSWORD}}",
    "cpf": "{{CUSTOMER_CPF}}",
    "phone": "{{CUSTOMER_PHONE}}"
  }
}

vars:pre-request {
  CUSTOMER_NAME:
  CUSTOMER_EMAIL:
  CUSTOMER_PASSWORD:
}

tests {
  test("returns generic 202 Accepted", function () {
    expect(res.status).to.equal(202);
  });
}

docs {
  Creates a customer, normalizes the email, hashes the password and assigns the CLIENTE profile.
  The response is always a body-less 202 — identical whether the email is new or already
  registered — so the endpoint cannot be used to probe which emails have accounts.
  
  The account is created inactive (ativo = false) and a confirmation e-mail is sent via
  SendGrid to CUSTOMER_EMAIL. "Login customer" below will return 401 until you run
  "Confirm email" — see that request's docs for how to get the token.
  
  CUSTOMER_ID is captured later by "Get authenticated customer".
}
