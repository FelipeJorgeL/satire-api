meta {
  name: Register customer
  type: http
  seq: 1
  tags: [
    customer
    smoke
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{CUSTOMER_NAME}}",
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "{{CUSTOMER_PASSWORD}}",
    "cpf": "{{CUSTOMER_CPF}}",
    "phone": "{{CUSTOMER_PHONE}}"
  }
}

tests {
  test("returns 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("does not expose password data", function () {
    expect(res.body).not.to.have.property("password");
    expect(res.body).not.to.have.property("passwordHash");
  });
}

docs {
  Creates a customer, normalizes the email, hashes the password and assigns the CLIENTE profile.
  Change CUSTOMER_EMAIL or CUSTOMER_CPF before running again because both values must be unique.
}
