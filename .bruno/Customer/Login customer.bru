meta {
  name: Login customer
  type: http
  seq: 4
  tags: [
    customer
    smoke
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "{{CUSTOMER_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("ACCESS_TOKEN", res.body.accessToken);
    bru.setEnvVar("REFRESH_TOKEN", res.body.refreshToken);
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer token and a refresh token", function () {
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}

docs {
  Run "Register customer" then "Confirm email" first — login fails with 401 on an
  inactive (unconfirmed) account.
  Saves accessToken into ACCESS_TOKEN and refreshToken into REFRESH_TOKEN, used by
  "Get authenticated customer", "Refresh access token" and "Logout customer" below.
}
