meta {
  name: Login customer
  type: http
  seq: 3
  tags: [
    customer
    smoke
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "{{CUSTOMER_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("ACCESS_TOKEN", res.body.accessToken);
    bru.setEnvVar("REFRESH_TOKEN", res.body.refreshToken);
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns bearer and refresh tokens", function () {
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
  });
}

docs {
  Run "Register customer" and "Confirm email" first. Unconfirmed accounts receive 401.
  Saves the access token into ACCESS_TOKEN and the refresh token into REFRESH_TOKEN for
  "Get authenticated customer", "Refresh access token" and "Logout customer" below.
}
