meta {
  name: Login customer
  type: http
  seq: 3
  tags: [
    customer
    smoke
  ]
}

post {
  url: {{BASE_URL}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{CUSTOMER_EMAIL}}",
    "password": "{{CUSTOMER_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("ACCESS_TOKEN", res.body.accessToken);
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer token", function () {
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.accessToken).to.be.a("string");
  });
}

docs {
  Run "Register customer" first so CUSTOMER_EMAIL/CUSTOMER_PASSWORD exist.
  Saves the token into ACCESS_TOKEN for "Get authenticated customer" and
  "Reject customer lookup without admin profile" below.
}
