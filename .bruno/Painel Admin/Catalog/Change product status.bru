  url: {{BASE_URL}}/api/v1/admin/products/{{PRODUCT_ID}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ADMIN_ACCESS_TOKEN}}
  Content-Type: application/json
}

body:json {
  {"active":true}
}

