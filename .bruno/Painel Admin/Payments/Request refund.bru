meta {
  name: Request refund
  type: http
  seq: 100
  tags: [
    bruno
    admin
  ]
}

post {
  url: {{BASE_URL}}/api/v1/admin/payments/{{PAYMENT_ID}}/refund
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ADMIN_ACCESS_TOKEN}}
  Idempotency-Key: bruno-refund-0001
  Content-Type: application/json
}

body:json {
  {"reason":"Solicitação administrativa de estorno"}
}

docs {
  Requests a simulated refund for an approved payment. No real financial refund is executed.
}

