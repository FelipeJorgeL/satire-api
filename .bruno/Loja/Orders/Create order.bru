meta {
  name: Create order
  type: http
  seq: 100
  tags: [
    bruno
    store
  ]
}

post {
  url: {{BASE_URL}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
  Content-Type: application/json
}

body:json {
  {"addressId":"{{ADDRESS_ID}}"}
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("ORDER_ID", res.body.id);
  }
}

docs {
  Creates the order from the authenticated customer's cart and saves ORDER_ID for the
  payment, shipment and order-query requests.
}

