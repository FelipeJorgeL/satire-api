meta {
  name: List product variations
  type: http
  seq: 6
  tags: [
    store
    catalog
  ]
}

get {
  url: {{BASE_URL}}/api/v1/products/{{PRODUCT_ID}}/variations
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setEnvVar("VARIATION_ID", res.body[0].id);
  }
}

docs {
  Lists active variations and saves the first variation ID.
}
